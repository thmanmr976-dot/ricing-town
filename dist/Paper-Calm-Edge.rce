        "fontAsset": ""
      },
      "workspaceContent": [
        "Make room for quiet work.\nOne window at a time.",
        "01  Review the inbox\n02  Draft the project outline\n03  Take a 20-minute focus sprint\n04  Plan tomorrow’s first step",
        "Capture one useful thought.\nLeave the rest for later.",
        "Clear the desk.\nChoose the next three priorities.",
        "Notice what worked.\nAdjust one thing for tomorrow."
      ],
